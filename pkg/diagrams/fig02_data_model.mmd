erDiagram
    SOURCE ||--o{ SCHOLARSHIP : publishes
    SCHOLARSHIP ||--o{ SCHOLARSHIP_VERSION : "tracks history of"
    SCHOLARSHIP_VERSION ||--o{ EVIDENCE : "is backed by"
    SOURCE ||--o{ EVIDENCE : "is origin of"
    SCHOLARSHIP ||--o{ COMMUNITY_INSIGHT : "discussed in"
    STUDENT_PROFILE ||--o{ DOCUMENT : owns
    STUDENT_PROFILE ||--o{ APPLICATION : submits
    SCHOLARSHIP ||--o{ APPLICATION : receives
    APPLICATION }o--o{ DOCUMENT : attaches
    APPLICATION ||--o{ AWARD_RENEWAL : "may lead to"
